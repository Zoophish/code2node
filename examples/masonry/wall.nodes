import panels
import support
import core
import partition
import jumpers
import stone

// shell/wall.nodes — coursed stonework from a shell.
//
// Feed it a shell: the wall surface with no thickness, standing on a flat
// base. mas Shell Panels reads the topology off it — panels, corners, free
// ends, heights — and hands back one spline per panel. Everything after that
// works in arc length along a spline, so a panel that curves is not a special
// case: it is the same layout with a curved ruler.
//
// One course stack is cut for the whole wall from the shell's height, every
// panel's length is cut into blocks of irregular width, and every block
// becomes a closed weathered solid. Corners are quoined, alternating course by
// course; a stone that would poke above the shell is not laid.
//
// Two things the box-massing tool could not do:
//
//   losses hold each other up — a stone is lost if its own draw says so or if
//   nothing under it survived, settled bottom-up one course at a time, so a
//   hole opens into a ragged edge rather than leaving stones in mid-air
//
//   exposure drives the wear — how close a stone is to the top of the wall or
//   to a free end raises its chance of being lost, deepens its chips and
//   nibbles its size, so a ruin loses its edges first
//
// Layout is a flat grid, one point per potential stone:
//   panel r = index / 2304, course c = (index / 48) mod 48, slot j = index mod 48
//
// Origin and scale: the tool builds in the shell's own space and adds nothing
// outside it. Sizes are metres. Hash channels 20-25 belong to this file.

tree "Shell Masonry Wall" [GeometryNodeTree] {
  interface {
    inputs {
      "Geometry": [NodeSocketGeometry],
      "Thickness": [NodeSocketFloat] = 0.5,
      "Curve Angle": [NodeSocketFloat] = 30.0,
      "Min Block Width": [NodeSocketFloat] = 0.35,
      "Max Block Width": [NodeSocketFloat] = 0.75,
      "Min Course Height": [NodeSocketFloat] = 0.18,
      "Max Course Height": [NodeSocketFloat] = 0.32,
      "Jumper Chance": [NodeSocketFloat] = 0.3,
      "Quoin Length": [NodeSocketFloat] = 0.3,
      "Mortar Gap": [NodeSocketFloat] = 0.015,
      "Edge Rounding": [NodeSocketFloat] = 0.02,
      "Irregularity": [NodeSocketFloat] = 0.006,
      "Chip Chance": [NodeSocketFloat] = 0.2,
      "Chip Depth": [NodeSocketFloat] = 0.05,
      "Missing Chance": [NodeSocketFloat] = 0.0,
      "Wear": [NodeSocketFloat] = 0.0,
      "Wear Height": [NodeSocketFloat] = 0.7,
      "Wear Reach": [NodeSocketFloat] = 0.9,
      "Wear Bite": [NodeSocketFloat] = 0.03,
      "Seed": [NodeSocketInt] = 0,
    }
    outputs {
      "Geometry": [NodeSocketGeometry],
    }
  }

  node "Group Input" [NodeGroupInput] @(-2600, 0) {
  }

  // ---- A: the shell becomes panels ---------------------------------------

  node "Panels" [GeometryNodeGroup] @(-2360, 200) {
    node_tree = "mas Shell Panels"
    inputs {
      ("Shell") -> "Group Input"("Geometry"),
      ("Curve Angle") -> "Group Input"("Curve Angle"),
      ("Thickness") -> "Group Input"("Thickness"),
    }
  }

  node "P H" [GeometryNodeInputNamedAttribute] @(-2360, -300) {
    inputs {
      (0: "Name") = "mas_h",
    }
  }

  node "P Thk" [GeometryNodeInputNamedAttribute] @(-2360, -420) {
    inputs {
      (0: "Name") = "mas_thk",
    }
  }

  node "P D" [GeometryNodeInputNamedAttribute] @(-2360, -540) {
    inputs {
      (0: "Name") = "mas_d",
    }
  }

  node "P Own" [GeometryNodeInputNamedAttribute] @(-2360, -660) {
    inputs {
      (0: "Name") = "mas_own",
    }
  }

  node "P Val" [GeometryNodeInputNamedAttribute] @(-2360, -780) {
    inputs {
      (0: "Name") = "mas_val",
    }
  }

  node "P Len" [GeometryNodeSplineLength] @(-2360, -900) {
  }

  node "P D0" [GeometryNodeInputNamedAttribute] @(-2360, -1020) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_d0",
    }
  }

  node "P D1" [GeometryNodeInputNamedAttribute] @(-2360, -1140) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_d1",
    }
  }

  // ---- B: one course stack for the whole wall ----------------------------
  //
  // Courses belong to the wall as a whole: two panels meeting at a corner
  // have to bed at the same levels or the quoins cannot interlock. The stack
  // is cut once from the shell's own height, and a stone whose course rises
  // above the shell where it stands is simply not laid.

  expr<float> "Span H" @(-2120, 400) {
    expression = "max(top - base, 0.0)"
    inputs {
      "top" -> "Panels"(3: "Top"),
      "base" -> "Panels"(2: "Base"),
    }
  }

  node "Courses" [GeometryNodePoints] @(-1640, 400) {
    inputs {
      (0: "Count") = 48,
    }
  }

  node "K Index" [GeometryNodeInputIndex] @(-2120, 100) {
  }

  node "K Piece" [GeometryNodeGroup] @(-1880, 100) {
    node_tree = "mas Hash Range"
    inputs {
      ("Y") -> "K Index"(0: "Index"),
      ("Channel") = 20.0,
      ("Seed") -> "Group Input"("Seed"),
      ("Min") -> "Group Input"("Min Course Height"),
      ("Max") -> "Group Input"("Max Course Height"),
    }
  }

  expr<float> "K Mean" @(-1880, -100) {
    expression = "(lo + hi) * 0.5"
    inputs {
      "lo" -> "Group Input"("Min Course Height"),
      "hi" -> "Group Input"("Max Course Height"),
    }
  }

  node "K Count" [GeometryNodeGroup] @(-1640, -100) {
    node_tree = "mas Slot Count"
    inputs {
      ("Span") -> "Span H"(0: "Value"),
      ("Mean") -> "K Mean"(0: "Value"),
      ("Cap") = 48.0,
    }
  }

  node "K Part" [GeometryNodeGroup] @(-1400, 100) {
    node_tree = "mas Span Partition"
    inputs {
      ("Span") -> "Span H"(0: "Value"),
      ("Slot") -> "K Index"(0: "Index"),
      ("Count") -> "K Count"(0: "Count"),
      ("Piece") -> "K Piece"(0: "Value"),
    }
  }

  node "K St Z0" [GeometryNodeStoreNamedAttribute] @(-1160, 400) {
    inputs {
      (0: "Geometry") -> "Courses"(0: "Points"),
      (2: "Name") = "mas_cz0",
      (3: "Value") -> "K Part"(0: "Start"),
    }
  }

  node "K St H" [GeometryNodeStoreNamedAttribute] @(-960, 400) {
    inputs {
      (0: "Geometry") -> "K St Z0"(0: "Geometry"),
      (2: "Name") = "mas_ch",
      (3: "Value") -> "K Part"(2: "Size"),
    }
  }

  node "K St Act" [GeometryNodeStoreNamedAttribute] @(-760, 400) {
    data_type = "BOOLEAN"
    inputs {
      (0: "Geometry") -> "K St H"(0: "Geometry"),
      (2: "Name") = "mas_cact",
      (3: "Value") -> "K Part"(3: "Active"),
    }
  }

  node "C Z0" [GeometryNodeInputNamedAttribute] @(-760, 160) {
    inputs {
      (0: "Name") = "mas_cz0",
    }
  }

  node "C H" [GeometryNodeInputNamedAttribute] @(-760, 40) {
    inputs {
      (0: "Name") = "mas_ch",
    }
  }

  node "C Act" [GeometryNodeInputNamedAttribute] @(-760, -80) {
    data_type = "BOOLEAN"
    inputs {
      (0: "Name") = "mas_cact",
    }
  }

  // ---- C: one point per potential stone, 48 per course -------------------

  expr<float> "Grid Total" @(-520, 600) {
    expression = "n * 2304.0"
    inputs {
      "n" -> "Panels"(1: "Count"),
    }
  }

  node "Grid" [GeometryNodePoints] @(-280, 600) {
    inputs {
      (0: "Count") -> "Grid Total"(0: "Value"),
    }
  }

  node "G Index" [GeometryNodeInputIndex] @(-520, -200) {
  }

  expr<float> "G Run" @(-280, -200) {
    expression = "floor(g / 2304.0)"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  expr<float> "G Key" @(-280, -300) {
    expression = "floor(g / 48.0)"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  expr<float> "G Course" @(-40, -300) {
    expression = "floor(g / 48.0) - floor(g / 2304.0) * 48.0"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  expr<float> "G Slot" @(-280, -400) {
    expression = "g - floor(g / 48.0) * 48.0"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  expr<float> "G Odd" @(-40, -400) {
    expression = "mod(floor(g / 48.0) - floor(g / 2304.0) * 48.0, 2.0)"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  expr<float> "G Course Up" @(-40, -600) {
    expression = "floor(g / 48.0) - floor(g / 2304.0) * 48.0 + 1.0"
    inputs {
      "g" -> "G Index"(0: "Index"),
    }
  }

  node "G Run Int" [FunctionNodeFloatToInt] @(200, -200) {
    inputs {
      (0: "Float") -> "G Run"(0: "Value"),
    }
  }

  node "G Key Int" [FunctionNodeFloatToInt] @(200, -300) {
    inputs {
      (0: "Float") -> "G Key"(0: "Value"),
    }
  }

  node "G Course Int" [FunctionNodeFloatToInt] @(200, -400) {
    inputs {
      (0: "Float") -> "G Course"(0: "Value"),
    }
  }

  node "G Course Up Int" [FunctionNodeFloatToInt] @(200, -600) {
    inputs {
      (0: "Float") -> "G Course Up"(0: "Value"),
    }
  }

  // course properties, this course and the one above

  node "S CZ0" [GeometryNodeSampleIndex] @(440, 400) {
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C Z0"(0: "Attribute"),
      (2: "Index") -> "G Course Int"(0: "Integer"),
    }
  }

  node "S CH" [GeometryNodeSampleIndex] @(440, 260) {
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C H"(0: "Attribute"),
      (2: "Index") -> "G Course Int"(0: "Integer"),
    }
  }

  node "S CAct" [GeometryNodeSampleIndex] @(440, 120) {
    data_type = "BOOLEAN"
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C Act"(0: "Attribute"),
      (2: "Index") -> "G Course Int"(0: "Integer"),
    }
  }

  node "S CZ0 Up" [GeometryNodeSampleIndex] @(440, -20) {
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C Z0"(0: "Attribute"),
      (2: "Index") -> "G Course Up Int"(0: "Integer"),
    }
  }

  node "S CH Up" [GeometryNodeSampleIndex] @(440, -160) {
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C H"(0: "Attribute"),
      (2: "Index") -> "G Course Up Int"(0: "Integer"),
    }
  }

  node "S CAct Up" [GeometryNodeSampleIndex] @(440, -300) {
    data_type = "BOOLEAN"
    inputs {
      (0: "Geometry") -> "K St Act"(0: "Geometry"),
      (1: "Value") -> "C Act"(0: "Attribute"),
      (2: "Index") -> "G Course Up Int"(0: "Integer"),
    }
  }

  // ---- D: what this panel's course may fill ------------------------------
  //
  // Both ends of the panel are read off the spline. A free end stops where
  // the shell stops; a corner reaches mas_d past the junction on the courses
  // this panel owns and pulls mas_d back on the courses it does not; a stem
  // at a T always pulls back to the through wall's face.

  node "R Len" [GeometryNodeSampleIndex] @(440, -700) {
    domain = "CURVE"
    inputs {
      (0: "Geometry") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Len"(0: "Length"),
      (2: "Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E0 D" [GeometryNodeSampleCurve] @(440, -900) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D"(0: "Attribute"),
      (2: "Factor") = 0.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E0 Own" [GeometryNodeSampleCurve] @(440, -1100) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Own"(0: "Attribute"),
      (2: "Factor") = 0.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E0 Val" [GeometryNodeSampleCurve] @(440, -1300) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Val"(0: "Attribute"),
      (2: "Factor") = 0.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E1 D" [GeometryNodeSampleCurve] @(440, -1500) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D"(0: "Attribute"),
      (2: "Factor") = 1.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E1 Own" [GeometryNodeSampleCurve] @(440, -1700) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Own"(0: "Attribute"),
      (2: "Factor") = 1.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E1 Val" [GeometryNodeSampleCurve] @(440, -1900) {
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Val"(0: "Attribute"),
      (2: "Factor") = 1.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  // which way the mating wall leaves each junction: of the two edge
  // directions the panel reader saw there, the mating one is the one not
  // aligned with this panel's own end tangent

  node "E0 V0" [GeometryNodeSampleCurve] @(200, -2300) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D0"(0: "Attribute"),
      (2: "Factor") = 0.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E0 V1" [GeometryNodeSampleCurve] @(200, -2500) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D1"(0: "Attribute"),
      (2: "Factor") = 0.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E1 V0" [GeometryNodeSampleCurve] @(200, -2700) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D0"(0: "Attribute"),
      (2: "Factor") = 1.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E1 V1" [GeometryNodeSampleCurve] @(200, -2900) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P D1"(0: "Attribute"),
      (2: "Factor") = 1.0,
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  node "E0 Dot0" [ShaderNodeVectorMath] @(440, -2300) {
    operation = "DOT_PRODUCT"
    inputs {
      (0: "Vector") -> "E0 D"(2: "Tangent"),
      (1: "Vector") -> "E0 V0"(0: "Value"),
    }
  }

  node "E0 Dot1" [ShaderNodeVectorMath] @(440, -2500) {
    operation = "DOT_PRODUCT"
    inputs {
      (0: "Vector") -> "E0 D"(2: "Tangent"),
      (1: "Vector") -> "E0 V1"(0: "Value"),
    }
  }

  node "E1 Dot0" [ShaderNodeVectorMath] @(440, -2700) {
    operation = "DOT_PRODUCT"
    inputs {
      (0: "Vector") -> "E1 D"(2: "Tangent"),
      (1: "Vector") -> "E1 V0"(0: "Value"),
    }
  }

  node "E1 Dot1" [ShaderNodeVectorMath] @(440, -2900) {
    operation = "DOT_PRODUCT"
    inputs {
      (0: "Vector") -> "E1 D"(2: "Tangent"),
      (1: "Vector") -> "E1 V1"(0: "Value"),
    }
  }

  // the tangent at end 0 points into the panel, at end 1 out of it, so the
  // mating direction is the smaller dot at end 0 and the larger at end 1

  expr<float> "E0 Pick" @(680, -2400) {
    expression = "greater_than(d0, d1)"
    inputs {
      "d0" -> "E0 Dot0"(1: "Value"),
      "d1" -> "E0 Dot1"(1: "Value"),
    }
  }

  expr<float> "E1 Pick" @(680, -2800) {
    expression = "less_than(d0, d1)"
    inputs {
      "d0" -> "E1 Dot0"(1: "Value"),
      "d1" -> "E1 Dot1"(1: "Value"),
    }
  }

  node "E0 Other" [ShaderNodeMix] @(920, -2400) {
    data_type = "VECTOR"
    inputs {
      (0: "Factor") -> "E0 Pick"(0: "Value"),
      (4: "A") -> "E0 V0"(0: "Value"),
      (5: "B") -> "E0 V1"(0: "Value"),
    }
  }

  node "E1 Other" [ShaderNodeMix] @(920, -2800) {
    data_type = "VECTOR"
    inputs {
      (0: "Factor") -> "E1 Pick"(0: "Value"),
      (4: "A") -> "E1 V0"(0: "Value"),
      (5: "B") -> "E1 V1"(0: "Value"),
    }
  }

  expr<float> "Free 0" @(700, -1300) {
    expression = "less_than(v, 1.5)"
    inputs {
      "v" -> "E0 Val"(0: "Value"),
    }
  }

  expr<float> "Free 1" @(700, -1900) {
    expression = "less_than(v, 1.5)"
    inputs {
      "v" -> "E1 Val"(0: "Value"),
    }
  }

  expr<float> "Corner 0" @(700, -1400) {
    expression = "compare(v, 2.0, 0.5)"
    inputs {
      "v" -> "E0 Val"(0: "Value"),
    }
  }

  expr<float> "Corner 1" @(700, -2000) {
    expression = "compare(v, 2.0, 0.5)"
    inputs {
      "v" -> "E1 Val"(0: "Value"),
    }
  }

  expr<float> "Stem 0" @(700, -1500) {
    expression = "greater_than(v, 2.5)"
    inputs {
      "v" -> "E0 Val"(0: "Value"),
    }
  }

  expr<float> "Stem 1" @(700, -2100) {
    expression = "greater_than(v, 2.5)"
    inputs {
      "v" -> "E1 Val"(0: "Value"),
    }
  }

  expr<float> "Owns 0" @(940, -1400) {
    expression = "c * (o + odd - 2.0 * o * odd)"
    inputs {
      "c" -> "Corner 0"(0: "Value"),
      "o" -> "E0 Own"(0: "Value"),
      "odd" -> "G Odd"(0: "Value"),
    }
  }

  expr<float> "Owns 1" @(940, -2000) {
    expression = "c * (o + odd - 2.0 * o * odd)"
    inputs {
      "c" -> "Corner 1"(0: "Value"),
      "o" -> "E1 Own"(0: "Value"),
      "odd" -> "G Odd"(0: "Value"),
    }
  }

  expr<float> "Span A" @(1180, -1400) {
    expression = "(c + s - 2.0 * own) * d"
    inputs {
      "c" -> "Corner 0"(0: "Value"),
      "s" -> "Stem 0"(0: "Value"),
      "own" -> "Owns 0"(0: "Value"),
      "d" -> "E0 D"(0: "Value"),
    }
  }

  expr<float> "Span B" @(1180, -2000) {
    expression = "len - (c + s - 2.0 * own) * d"
    inputs {
      "len" -> "R Len"(0: "Value"),
      "c" -> "Corner 1"(0: "Value"),
      "s" -> "Stem 1"(0: "Value"),
      "own" -> "Owns 1"(0: "Value"),
      "d" -> "E1 D"(0: "Value"),
    }
  }

  expr<float> "Span" @(1420, -1700) {
    expression = "max(b - a, 0.0)"
    inputs {
      "a" -> "Span A"(0: "Value"),
      "b" -> "Span B"(0: "Value"),
    }
  }

  // the stretch both course parities agree on — a jumper may only live in
  // here, or it would poke into the corner the course above has given away

  expr<float> "Shared A" @(1180, -1600) {
    expression = "d * (1.0 - f)"
    inputs {
      "d" -> "E0 D"(0: "Value"),
      "f" -> "Free 0"(0: "Value"),
    }
  }

  expr<float> "Shared B" @(1180, -2200) {
    expression = "len - d * (1.0 - f)"
    inputs {
      "len" -> "R Len"(0: "Value"),
      "d" -> "E1 D"(0: "Value"),
      "f" -> "Free 1"(0: "Value"),
    }
  }

  expr<float> "Head" @(1420, -1400) {
    expression = "own * (d + q)"
    inputs {
      "own" -> "Owns 0"(0: "Value"),
      "d" -> "E0 D"(0: "Value"),
      "q" -> "Group Input"("Quoin Length"),
    }
  }

  expr<float> "Tail" @(1420, -2000) {
    expression = "own * (d + q)"
    inputs {
      "own" -> "Owns 1"(0: "Value"),
      "d" -> "E1 D"(0: "Value"),
      "q" -> "Group Input"("Quoin Length"),
    }
  }

  // ---- E: blocks across the course ---------------------------------------

  expr<float> "W Low" @(700, 400) {
    expression = "0.75 * lo + 0.25 * hi"
    inputs {
      "lo" -> "Group Input"("Min Block Width"),
      "hi" -> "Group Input"("Max Block Width"),
    }
  }

  expr<float> "W High" @(700, 300) {
    expression = "0.25 * lo + 0.75 * hi"
    inputs {
      "lo" -> "Group Input"("Min Block Width"),
      "hi" -> "Group Input"("Max Block Width"),
    }
  }

  node "W Mean" [GeometryNodeGroup] @(940, 360) {
    node_tree = "mas Hash Range"
    inputs {
      ("X") -> "G Run"(0: "Value"),
      ("Y") -> "G Course"(0: "Value"),
      ("Z") = 777.0,
      ("Channel") = 21.0,
      ("Seed") -> "Group Input"("Seed"),
      ("Min") -> "W Low"(0: "Value"),
      ("Max") -> "W High"(0: "Value"),
    }
  }

  node "W Piece" [GeometryNodeGroup] @(940, 160) {
    node_tree = "mas Hash Range"
    inputs {
      ("X") -> "G Run"(0: "Value"),
      ("Y") -> "G Course"(0: "Value"),
      ("Z") -> "G Slot"(0: "Value"),
      ("Channel") = 22.0,
      ("Seed") -> "Group Input"("Seed"),
      ("Min") -> "Group Input"("Min Block Width"),
      ("Max") -> "Group Input"("Max Block Width"),
    }
  }

  node "B Count" [GeometryNodeGroup] @(1660, 360) {
    node_tree = "mas Slot Count"
    inputs {
      ("Span") -> "Span"(0: "Value"),
      ("Mean") -> "W Mean"(0: "Value"),
      ("Cap") = 48.0,
      ("Head") -> "Head"(0: "Value"),
      ("Tail") -> "Tail"(0: "Value"),
    }
  }

  node "B Part" [GeometryNodeGroup] @(1900, 200) {
    node_tree = "mas Span Partition"
    inputs {
      ("Span") -> "Span"(0: "Value"),
      ("Slot") -> "G Slot"(0: "Value"),
      ("Count") -> "B Count"(0: "Count"),
      ("Group ID") -> "G Key Int"(0: "Integer"),
      ("Piece") -> "W Piece"(0: "Value"),
      ("Enabled") -> "S CAct"(0: "Value"),
      ("Head") -> "Head"(0: "Value"),
      ("Tail") -> "Tail"(0: "Value"),
    }
  }

  expr<float> "U0" @(2140, 200) {
    expression = "a + s"
    inputs {
      "a" -> "Span A"(0: "Value"),
      "s" -> "B Part"(0: "Start"),
    }
  }

  expr<float> "U1" @(2140, 80) {
    expression = "a + e"
    inputs {
      "a" -> "Span A"(0: "Value"),
      "e" -> "B Part"(1: "End"),
    }
  }

  expr<float> "Quoin" @(2140, -40) {
    expression = "min(1.0, hd + tl)"
    inputs {
      "hd" -> "B Part"(4: "Is Head"),
      "tl" -> "B Part"(5: "Is Tail"),
    }
  }

  // the first and last block of a course at a corner get their end face cut
  // in the mating wall's face plane, owning or not, so the arris comes out
  // clean at any angle

  expr<float> "CF0" @(2140, -280) {
    expression = "compare(slot, 0.0, 0.1) * c"
    inputs {
      "slot" -> "G Slot"(0: "Value"),
      "c" -> "Corner 0"(0: "Value"),
    }
  }

  expr<float> "CF1" @(2140, -400) {
    expression = "compare(slot, n - 1.0, 0.1) * c"
    inputs {
      "slot" -> "G Slot"(0: "Value"),
      "n" -> "B Count"(0: "Count"),
      "c" -> "Corner 1"(0: "Value"),
    }
  }

  // a stone is not laid where the shell has already stopped: the course stack
  // is the whole wall's, but the height it is cut against is local

  expr<float> "Mid U" @(2140, -160) {
    expression = "min(max((u0 + u1) * 0.5, 0.0), len)"
    inputs {
      "u0" -> "U0"(0: "Value"),
      "u1" -> "U1"(0: "Value"),
      "len" -> "R Len"(0: "Value"),
    }
  }

  node "Local H" [GeometryNodeSampleCurve] @(2380, -160) {
    mode = "LENGTH"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P H"(0: "Attribute"),
      (3: "Length") -> "Mid U"(0: "Value"),
      (4: "Curve Index") -> "G Run Int"(0: "Integer"),
    }
  }

  // The height a stone courses against is the shell face it stands on, not
  // an interpolation between plan vertices — heights step at a segment
  // boundary rather than ramping across the whole segment. Every face of a
  // stack shares its plan centre (sides are vertical), so one point per
  // face, dropped by a scaled copy of its column top, lets a nearest lookup
  // from below pick the top of exactly the column the stone stands in.
  // Faces are quads: the four corners are the whole face.

  node "W Pos" [GeometryNodeInputPosition] @(2380, -2400) {
  }

  node "W XYZ" [ShaderNodeSeparateXYZ] @(2560, -2400) {
    inputs {
      (0: "Vector") -> "W Pos"(0: "Position"),
    }
  }

  node "F Idx" [GeometryNodeInputIndex] @(2380, -2540) {
  }

  node "F C0" [GeometryNodeCornersOfFace] @(2560, -2540) {
    inputs {
      (0: "Face Index") -> "F Idx"(0: "Index"),
      (2: "Sort Index") = 0,
    }
  }

  node "F C1" [GeometryNodeCornersOfFace] @(2560, -2680) {
    inputs {
      (0: "Face Index") -> "F Idx"(0: "Index"),
      (2: "Sort Index") = 1,
    }
  }

  node "F C2" [GeometryNodeCornersOfFace] @(2560, -2820) {
    inputs {
      (0: "Face Index") -> "F Idx"(0: "Index"),
      (2: "Sort Index") = 2,
    }
  }

  node "F C3" [GeometryNodeCornersOfFace] @(2560, -2960) {
