  }

  node "A Quoin" [GeometryNodeInputNamedAttribute] @(6340, -640) {
    data_type = "BOOLEAN"
    inputs {
      (0: "Name") = "mas_quoin",
    }
  }

  node "A Sid" [GeometryNodeInputNamedAttribute] @(6340, -760) {
    data_type = "INT"
    inputs {
      (0: "Name") = "mas_sid",
    }
  }

  node "A Run" [GeometryNodeInputNamedAttribute] @(6340, -880) {
    data_type = "INT"
    inputs {
      (0: "Name") = "mas_run",
    }
  }

  node "A Len" [GeometryNodeInputNamedAttribute] @(6340, -1000) {
    inputs {
      (0: "Name") = "mas_len",
    }
  }

  node "A F0" [GeometryNodeInputNamedAttribute] @(6340, -1120) {
    inputs {
      (0: "Name") = "mas_f0",
    }
  }

  node "A F1" [GeometryNodeInputNamedAttribute] @(6340, -1240) {
    inputs {
      (0: "Name") = "mas_f1",
    }
  }

  node "A LH" [GeometryNodeInputNamedAttribute] @(6340, -1360) {
    inputs {
      (0: "Name") = "mas_lh",
    }
  }

  expr<float> "Not Jumper" @(6580, -400) {
    expression = "1.0 - act * jmp"
    inputs {
      "act" -> "A Act"(0: "Attribute"),
      "jmp" -> "A Jmp"(0: "Attribute"),
    }
  }

  node "J Only" [GeometryNodeDeleteGeometry] @(6820, 400) {
    inputs {
      (0: "Geometry") -> "G St OD1"(0: "Geometry"),
      (1: "Selection") -> "Not Jumper"(0: "Value"),
    }
  }

  expr<float> "J Mid" @(6580, -200) {
    expression = "(u0 + u1) * 0.5"
    inputs {
      "u0" -> "A U0"(0: "Attribute"),
      "u1" -> "A U1"(0: "Attribute"),
    }
  }

  expr<float> "J Row" @(6580, -520) {
    expression = "k * 1000.0"
    inputs {
      "k" -> "A Key"(0: "Attribute"),
    }
  }

  node "J At" [ShaderNodeCombineXYZ] @(6820, -300) {
    inputs {
      (0: "X") -> "J Mid"(0: "Value"),
      (1: "Y") -> "J Row"(0: "Value"),
    }
  }

  node "J Cloud" [GeometryNodeSetPosition] @(7060, 400) {
    inputs {
      (0: "Geometry") -> "J Only"(0: "Geometry"),
      (2: "Position") -> "J At"(0: "Vector"),
    }
  }

  expr<float> "Clamp Min" @(7060, 200) {
    expression = "gap + 0.01"
    inputs {
      "gap" -> "Group Input"("Mortar Gap"),
    }
  }

  node "Clamp 1" [GeometryNodeGroup] @(7300, 600) {
    node_tree = "mas Jumper Clamp"
    inputs {
      ("Grid") -> "G St OD1"(0: "Geometry"),
      ("Jumpers") -> "J Cloud"(0: "Geometry"),
      ("Min Width") -> "Clamp Min"(0: "Value"),
      ("Probe") = 0.5,
    }
  }

  node "Clamp 2" [GeometryNodeGroup] @(7540, 600) {
    node_tree = "mas Jumper Clamp"
    inputs {
      ("Grid") -> "Clamp 1"(0: "Grid"),
      ("Jumpers") -> "J Cloud"(0: "Geometry"),
      ("Min Width") -> "Clamp Min"(0: "Value"),
      ("Probe") = 0.12,
    }
  }

  node "Clamp 3" [GeometryNodeGroup] @(7780, 600) {
    node_tree = "mas Jumper Clamp"
    inputs {
      ("Grid") -> "Clamp 2"(0: "Grid"),
      ("Jumpers") -> "J Cloud"(0: "Geometry"),
      ("Min Width") -> "Clamp Min"(0: "Value"),
      ("Probe") = 0.88,
    }
  }

  // ---- I: exposure, then losses that hold each other up ------------------
  //
  // Exposure is how close a stone is to a face the weather can get at: the
  // top of the wall, or a free end where the shell simply stops. A stone in
  // the middle of a panel three courses down is at 0 and never wears.

  expr<float> "Top Gap" @(8020, -160) {
    expression = "max(lh - z1, 0.0)"
    inputs {
      "lh" -> "A LH"(0: "Attribute"),
      "z1" -> "A Z1"(0: "Attribute"),
    }
  }

  expr<float> "End Gap" @(8020, -300) {
    expression =
      "min(u0 + (1.0 - f0) * 1000.0, len - u1 + (1.0 - f1) * 1000.0)"
    inputs {
      "u0" -> "A U0"(0: "Attribute"),
      "u1" -> "A U1"(0: "Attribute"),
      "len" -> "A Len"(0: "Attribute"),
      "f0" -> "A F0"(0: "Attribute"),
      "f1" -> "A F1"(0: "Attribute"),
    }
  }

  expr<float> "Exposure" @(8260, -230) {
    expression =
      "min(1.0, max(0.0, max(1.0 - tg / max(wh, 1e-4),
                             1.0 - eg / max(wr, 1e-4))))"
    inputs {
      "tg" -> "Top Gap"(0: "Value"),
      "eg" -> "End Gap"(0: "Value"),
      "wh" -> "Group Input"("Wear Height"),
      "wr" -> "Group Input"("Wear Reach"),
    }
  }

  node "M Hash" [GeometryNodeGroup] @(8020, -500) {
    node_tree = "mas Hash"
    inputs {
      ("X") -> "A Sid"(0: "Attribute"),
      ("Channel") = 24.0,
      ("Seed") -> "Group Input"("Seed"),
    }
  }

  // a quoin is exempt from the flat loss — a hole at a corner reads as a
  // mistake — but not from exposure: a ruin loses its top corner too

  expr<float> "Loss Chance" @(8500, -400) {
    expression = "miss * (1.0 - q) + wear * x * x * (1.0 - 0.5 * q)"
    inputs {
      "miss" -> "Group Input"("Missing Chance"),
      "wear" -> "Group Input"("Wear"),
      "x" -> "Exposure"(0: "Value"),
      "q" -> "A Quoin"(0: "Attribute"),
    }
  }

  expr<float> "Lost 0" @(8740, -400) {
    expression = "act * less_than(h, c)"
    inputs {
      "act" -> "A Act"(0: "Attribute"),
      "h" -> "M Hash"(0: "Value"),
      "c" -> "Loss Chance"(0: "Value"),
    }
  }

  node "St P0" [GeometryNodeStoreNamedAttribute] @(7420, 600) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Geometry") -> "Clamp 3"(0: "Grid"),
      (2: "Name") = "mas_p0",
      (3: "Value") -> "P0"(0: "Vector"),
    }
  }

  node "St P1" [GeometryNodeStoreNamedAttribute] @(7620, 600) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Geometry") -> "St P0"(0: "Geometry"),
      (2: "Name") = "mas_p1",
      (3: "Value") -> "P1"(0: "Vector"),
    }
  }

  node "St Stk" [GeometryNodeStoreNamedAttribute] @(7820, 600) {
    inputs {
      (0: "Geometry") -> "St P1"(0: "Geometry"),
      (2: "Name") = "mas_stk",
      (3: "Value") -> "SC0"(0: "Value"),
    }
  }

  node "St Exp" [GeometryNodeStoreNamedAttribute] @(8020, 600) {
    inputs {
      (0: "Geometry") -> "St Stk"(0: "Geometry"),
      (2: "Name") = "mas_exp",
      (3: "Value") -> "Exposure"(0: "Value"),
    }
  }

  node "St Lost" [GeometryNodeStoreNamedAttribute] @(8980, 600) {
    inputs {
      (0: "Geometry") -> "St Exp"(0: "Geometry"),
      (2: "Name") = "mas_lost",
      (3: "Value") -> "Lost 0"(0: "Value"),
    }
  }

  node "Settle Count" [FunctionNodeFloatToInt] @(8980, 400) {
    inputs {
      (0: "Float") -> "K Count"(0: "Count"),
    }
  }

  repeat "Settle" @(9220, 600) {
    iterations -> "Settle Count"(0: "Integer")
    items {
      "Geometry": [NodeSocketGeometry] -> "St Lost"(0: "Geometry"),
    }

    node "Step" [GeometryNodeGroup] @(0, 0) {
      node_tree = "mas Loss Step"
      inputs {
        ("Grid") -> "repeat"(0: "Geometry"),
      }
    }

    outputs {
      "Geometry" -> "Step"(0: "Grid"),
    }
  }

  node "A Lost" [GeometryNodeInputNamedAttribute] @(9700, 200) {
    inputs {
      (0: "Name") = "mas_lost",
    }
  }

  node "A Exp" [GeometryNodeInputNamedAttribute] @(9700, 80) {
    inputs {
      (0: "Name") = "mas_exp",
    }
  }

  expr<float> "Drop" @(9940, 200) {
    expression = "1.0 - act * (1.0 - lost)"
    inputs {
      "act" -> "A Act"(0: "Attribute"),
      "lost" -> "A Lost"(0: "Attribute"),
    }
  }

  node "Stones" [GeometryNodeDeleteGeometry] @(10180, 600) {
    inputs {
      (0: "Geometry") -> "Settle"(0: "Geometry"),
      (1: "Selection") -> "Drop"(0: "Value"),
    }
  }

  // ---- J: every surviving slot becomes a solid stone ---------------------
  //
  // A block is a straight solid laid on the chord between its two ends of the
  // panel, so a curved panel comes out as a chorded run of stones — which is
  // how curved masonry is actually laid. Sampling past the end of the spline
  // is what a quoin needs, so the sample is clamped and then walked out along
  // the end tangent.

  expr<float> "S0 Clamp" @(10180, 200) {
    expression = "min(max(u, 0.0), len)"
    inputs {
      "u" -> "A U0"(0: "Attribute"),
      "len" -> "A Len"(0: "Attribute"),
    }
  }

  expr<float> "S1 Clamp" @(10180, 80) {
    expression = "min(max(u, 0.0), len)"
    inputs {
      "u" -> "A U1"(0: "Attribute"),
      "len" -> "A Len"(0: "Attribute"),
    }
  }

  node "SC0" [GeometryNodeSampleCurve] @(10420, 200) {
    mode = "LENGTH"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Thk"(0: "Attribute"),
      (3: "Length") -> "S0 Clamp"(0: "Value"),
      (4: "Curve Index") -> "A Run"(0: "Attribute"),
    }
  }

  node "SC1" [GeometryNodeSampleCurve] @(10420, -100) {
    mode = "LENGTH"
    inputs {
      (0: "Curves") -> "Panels"(0: "Panels"),
      (1: "Value") -> "P Thk"(0: "Attribute"),
      (3: "Length") -> "S1 Clamp"(0: "Value"),
      (4: "Curve Index") -> "A Run"(0: "Attribute"),
    }
  }

  expr<float> "S0 Over" @(10660, 340) {
    expression = "u - c"
    inputs {
      "u" -> "A U0"(0: "Attribute"),
      "c" -> "S0 Clamp"(0: "Value"),
    }
  }

  expr<float> "S1 Over" @(10660, 240) {
    expression = "u - c"
    inputs {
      "u" -> "A U1"(0: "Attribute"),
      "c" -> "S1 Clamp"(0: "Value"),
    }
  }

  node "T0" [ShaderNodeVectorMath] @(10900, 340) {
    operation = "SCALE"
    inputs {
      (0: "Vector") -> "SC0"(2: "Tangent"),
      (3: "Scale") -> "S0 Over"(0: "Value"),
    }
  }

  node "T1" [ShaderNodeVectorMath] @(10900, 240) {
    operation = "SCALE"
    inputs {
      (0: "Vector") -> "SC1"(2: "Tangent"),
      (3: "Scale") -> "S1 Over"(0: "Value"),
    }
  }

  node "P0" [ShaderNodeVectorMath] @(11140, 340) {
    inputs {
      (0: "Vector") -> "SC0"(1: "Position"),
      (1: "Vector") -> "T0"(0: "Vector"),
    }
  }

  node "P1" [ShaderNodeVectorMath] @(11140, 240) {
    inputs {
      (0: "Vector") -> "SC1"(1: "Position"),
      (1: "Vector") -> "T1"(0: "Vector"),
    }
  }

  node "A P0" [GeometryNodeInputNamedAttribute] @(11140, 60) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_p0",
    }
  }

  node "A P1" [GeometryNodeInputNamedAttribute] @(11140, -60) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_p1",
    }
  }

  node "A Stk" [GeometryNodeInputNamedAttribute] @(11140, -180) {
    inputs {
      (0: "Name") = "mas_stk",
    }
  }

  node "Chord" [ShaderNodeVectorMath] @(11380, 340) {
    operation = "SUBTRACT"
    inputs {
      (0: "Vector") -> "A P1"(0: "Attribute"),
      (1: "Vector") -> "A P0"(0: "Attribute"),
    }
  }

  // A stone is straight and the panel is not, so where two stones meet the
  // joint is cut radial: each end face turns from "square to the chord" to
  // "square to the curve at the joint", and the two faces meet in one plane
  // with the mortar gap between them, inside and outside face alike. At a
  // corner the first and last stone turn their end face further, into the
  // mating wall's face plane, which is what makes the arris clean at any
  // angle — the squint quoin. Both are the same operation on the solid: a
  // plan-angle cut about the face's own centre, and the two cuts land on the
  // same plane from either side, so neither leaves a wedge.

  node "Chord Dir" [ShaderNodeVectorMath] @(11620, 620) {
    operation = "NORMALIZE"
    inputs {
      (0: "Vector") -> "Chord"(0: "Vector"),
    }
  }

  node "T0 XYZ" [ShaderNodeSeparateXYZ] @(11620, 760) {
    inputs {
      (0: "Vector") -> "SC0"(2: "Tangent"),
    }
  }

  node "T1 XYZ" [ShaderNodeSeparateXYZ] @(11620, 900) {
    inputs {
      (0: "Vector") -> "SC1"(2: "Tangent"),
    }
  }

  node "A CF0" [GeometryNodeInputNamedAttribute] @(11620, 1040) {
    inputs {
      (0: "Name") = "mas_cf0",
    }
  }

  node "A CF1" [GeometryNodeInputNamedAttribute] @(11620, 1160) {
    inputs {
      (0: "Name") = "mas_cf1",
    }
  }

  node "A OD0" [GeometryNodeInputNamedAttribute] @(11620, 1280) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_od0",
    }
  }

  node "A OD1" [GeometryNodeInputNamedAttribute] @(11620, 1400) {
    data_type = "FLOAT_VECTOR"
    inputs {
      (0: "Name") = "mas_od1",
    }
  }

  node "OD0 XYZ" [ShaderNodeSeparateXYZ] @(11860, 1280) {
    inputs {
      (0: "Vector") -> "A OD0"(0: "Attribute"),
    }
  }

  node "OD1 XYZ" [ShaderNodeSeparateXYZ] @(11860, 1400) {
    inputs {
      (0: "Vector") -> "A OD1"(0: "Attribute"),
    }
  }

  node "Chord XYZ" [ShaderNodeSeparateXYZ] @(11620, 340) {
    inputs {
      (0: "Vector") -> "Chord"(0: "Vector"),
    }
  }

  // radial: the signed plan angle from the chord to the joint tangent

  expr<float> "R0" @(11860, 760) {
    expression =
      "min(max(atan2(cx * ty - cy * tx, cx * tx + cy * ty), 0.0 - 0.6), 0.6)"
    inputs {
      "cx" -> "Chord XYZ"(0: "X"),
      "cy" -> "Chord XYZ"(1: "Y"),
      "tx" -> "T0 XYZ"(0: "X"),
      "ty" -> "T0 XYZ"(1: "Y"),
    }
  }

  expr<float> "R1" @(11860, 900) {
    expression =
      "min(max(atan2(cx * ty - cy * tx, cx * tx + cy * ty), 0.0 - 0.6), 0.6)"
    inputs {
      "cx" -> "Chord XYZ"(0: "X"),
      "cy" -> "Chord XYZ"(1: "Y"),
      "tx" -> "T1 XYZ"(0: "X"),
      "ty" -> "T1 XYZ"(1: "Y"),
    }
  }

  // squint: turn the end face parallel to the mating wall's direction

  expr<float> "Ang0" @(12100, 1280) {
    expression = "atan2(cx * oy - cy * ox, cx * ox + cy * oy)"
    inputs {
      "cx" -> "Chord XYZ"(0: "X"),
      "cy" -> "Chord XYZ"(1: "Y"),
      "ox" -> "OD0 XYZ"(0: "X"),
      "oy" -> "OD0 XYZ"(1: "Y"),
    }
  }

  expr<float> "Ang1" @(12100, 1400) {
    expression = "atan2(cx * oy - cy * ox, cx * ox + cy * oy)"
    inputs {
      "cx" -> "Chord XYZ"(0: "X"),
      "cy" -> "Chord XYZ"(1: "Y"),
      "ox" -> "OD1 XYZ"(0: "X"),
      "oy" -> "OD1 XYZ"(1: "Y"),
    }
  }

  expr<float> "Ct0" @(12340, 1280) {
    expression = "a - 0.5 * pi * sign(a)"
    inputs {
      "a" -> "Ang0"(0: "Value"),
    }
  }

  expr<float> "Ct1" @(12340, 1400) {
    expression = "a - 0.5 * pi * sign(a)"
    inputs {
      "a" -> "Ang1"(0: "Value"),
    }
  }

  expr<float> "Tail Cut" @(12580, 1280) {
    expression = "cf * ct + (1.0 - cf) * r"
    inputs {
      "cf" -> "A CF0"(0: "Attribute"),
      "ct" -> "Ct0"(0: "Value"),
      "r" -> "R0"(0: "Value"),
    }
  }

  expr<float> "Head Cut" @(12580, 1400) {
    expression = "cf * ct + (1.0 - cf) * r"
    inputs {
      "cf" -> "A CF1"(0: "Attribute"),
      "ct" -> "Ct1"(0: "Value"),
      "r" -> "R1"(0: "Value"),
    }
  }

  node "Chord Len" [ShaderNodeVectorMath] @(11620, 460) {
    operation = "LENGTH"
    inputs {
      (0: "Vector") -> "Chord"(0: "Vector"),
    }
  }

  node "Mid P" [ShaderNodeVectorMath] @(11380, 140) {
    operation = "ADD"
    inputs {
      (0: "Vector") -> "A P0"(0: "Attribute"),
      (1: "Vector") -> "A P1"(0: "Attribute"),
    }
  }

  node "Mid H" [ShaderNodeVectorMath] @(11620, 140) {
    operation = "SCALE"
    inputs {
      (0: "Vector") -> "Mid P"(0: "Vector"),
      (3: "Scale") = 0.5,
    }
  }

  node "Mid XYZ" [ShaderNodeSeparateXYZ] @(11860, 140) {
    inputs {
      (0: "Vector") -> "Mid H"(0: "Vector"),
    }
  }

  expr<float> "Stone Z" @(11860, -20) {
    expression = "base + (z0 + z1) * 0.5 - 0.5 * bite"
    inputs {
      "base" -> "Panels"(2: "Base"),
      "z0" -> "A Z0"(0: "Attribute"),
      "z1" -> "A Z1"(0: "Attribute"),
      "bite" -> "Bite"(0: "Value"),
    }
  }

  node "Stone Centre" [ShaderNodeCombineXYZ] @(12100, 140) {
    inputs {
      (0: "X") -> "Mid XYZ"(0: "X"),
      (1: "Y") -> "Mid XYZ"(1: "Y"),
      (2: "Z") -> "Stone Z"(0: "Value"),
    }
  }

  // exposure is geometry and is always there; Wear is how much of it the
  // wall has actually suffered, so at Wear 0 nothing below is felt at all

  expr<float> "Worn" @(11380, -200) {
    expression = "min(1.0, w) * x"
    inputs {
      "w" -> "Group Input"("Wear"),
      "x" -> "A Exp"(0: "Attribute"),
    }
  }

  // Wear Bite is erosion, and erosion works on the weather: the two wall
  // faces recede, the top of the stone is eaten down, and the bed stays
  // seated on its course while the joints keep their gap — a stone shrunk
  // about its centroid instead just reads as bad mortar all round.

  expr<float> "Bite" @(11620, -200) {
    expression = "b * x"
    inputs {
      "b" -> "Group Input"("Wear Bite"),
      "x" -> "Worn"(0: "Value"),
    }
  }

  expr<float> "Half W" @(11860, -200) {
    expression = "max(0.5 * (l - gap), 0.01)"
    inputs {
      "l" -> "Chord Len"(1: "Value"),
      "gap" -> "Group Input"("Mortar Gap"),
    }
  }

  expr<float> "Half H" @(11860, -320) {
    expression = "max(0.5 * (z1 - z0 - gap) - 0.5 * bite, 0.01)"
    inputs {
      "z0" -> "A Z0"(0: "Attribute"),
      "z1" -> "A Z1"(0: "Attribute"),
      "gap" -> "Group Input"("Mortar Gap"),
      "bite" -> "Bite"(0: "Value"),
    }
  }

  expr<float> "Half T" @(11860, -440) {
    expression = "max(0.5 * t - bite, 0.01)"
    inputs {
      "t" -> "A Stk"(0: "Attribute"),
      "bite" -> "Bite"(0: "Value"),
    }
  }

  node "Stone Extents" [ShaderNodeCombineXYZ] @(12100, -300) {
    inputs {
      (0: "X") -> "Half W"(0: "Value"),
      (1: "Y") -> "Half T"(0: "Value"),
      (2: "Z") -> "Half H"(0: "Value"),
    }
  }

  expr<float> "Yaw" @(11860, -560) {
    expression = "atan2(dy, dx)"
    inputs {
      "dx" -> "Chord XYZ"(0: "X"),
      "dy" -> "Chord XYZ"(1: "Y"),
    }
  }

  node "Stone Rot" [FunctionNodeAxisAngleToRotation] @(12100, -560) {
    inputs {
      (1: "Angle") -> "Yaw"(0: "Value"),
    }
  }

  // a quoin is a dressed stone: it chips less and sits truer than the field,
  // which is what keeps the arris reading as one edge

  expr<float> "Wear Chip" @(12100, -700) {
    expression = "(c + (1.0 - c) * 0.6 * x) * (1.0 - 0.7 * q)"
    inputs {
      "c" -> "Group Input"("Chip Chance"),
      "x" -> "Worn"(0: "Value"),
      "q" -> "A Quoin"(0: "Attribute"),
    }
  }

  expr<float> "Wear Depth" @(12100, -820) {
    expression = "d * (1.0 + 2.0 * x)"
    inputs {
      "d" -> "Group Input"("Chip Depth"),
      "x" -> "Worn"(0: "Value"),
    }
  }

  expr<float> "Dress Irr" @(12100, -940) {
    expression = "irr * (1.0 - 0.7 * q)"
    inputs {
      "irr" -> "Group Input"("Irregularity"),
      "q" -> "A Quoin"(0: "Attribute"),
    }
  }

  node "Solids" [GeometryNodeGroup] @(12420, 600) {
    node_tree = "mas Stone Solid"
    inputs {
      ("Points") -> "Stones"(0: "Geometry"),
      ("Centre") -> "Stone Centre"(0: "Vector"),
      ("Half Extents") -> "Stone Extents"(0: "Vector"),
      ("Rotation") -> "Stone Rot"(0: "Rotation"),
      ("Head Cut") -> "Head Cut"(0: "Value"),
      ("Tail Cut") -> "Tail Cut"(0: "Value"),
      ("ID") -> "A Sid"(0: "Attribute"),
      ("Edge Rounding") -> "Group Input"("Edge Rounding"),
      ("Chip Chance") -> "Wear Chip"(0: "Value"),
      ("Chip Depth") -> "Wear Depth"(0: "Value"),
      ("Irregularity") -> "Dress Irr"(0: "Value"),
      ("Segments") = 4,
      ("Seed") -> "Group Input"("Seed"),
    }
  }

  node "Group Output" [NodeGroupOutput] @(12700, 600) {
    inputs {
      ("Geometry") -> "Solids"(0: "Geometry"),
    }
  }
}
