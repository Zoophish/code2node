  // ---- F: jumpers ---------------------------------------------------------

  node "J Hash" [GeometryNodeGroup] @(1900, -600) {
    node_tree = "mas Hash"
    inputs {
      ("X") -> "G Run"(0: "Value"),
      ("Y") -> "G Course"(0: "Value"),
      ("Z") -> "G Slot"(0: "Value"),
      ("Channel") = 23.0,
      ("Seed") -> "Group Input"("Seed"),
    }
  }

  expr<float> "Slot Prev" @(1900, -780) {
    expression = "j - 1.0"
    inputs {
      "j" -> "G Slot"(0: "Value"),
    }
  }

  node "J Prev Hash" [GeometryNodeGroup] @(2140, -780) {
    node_tree = "mas Hash"
    inputs {
      ("X") -> "G Run"(0: "Value"),
      ("Y") -> "G Course"(0: "Value"),
      ("Z") -> "Slot Prev"(0: "Value"),
      ("Channel") = 23.0,
      ("Seed") -> "Group Input"("Seed"),
    }
  }

  expr<float> "J Wide" @(2140, -960) {
    expression = "greater_than(w, 0.3 * lo + 0.7 * hi)"
    inputs {
      "w" -> "W Piece"(0: "Value"),
      "lo" -> "Group Input"("Min Block Width"),
      "hi" -> "Group Input"("Max Block Width"),
    }
  }

  // a jumper lives in the stretch both course parities agree on, and stays a
  // block clear of either end: a jumper that swallows the last stone of the
  // course above leaves a notch where the panel should finish square

  expr<float> "J Inside" @(2380, -960) {
    expression = "greater_than(u0, sa + m) * less_than(u1, sb - m)"
    inputs {
      "u0" -> "U0"(0: "Value"),
      "u1" -> "U1"(0: "Value"),
      "sa" -> "Shared A"(0: "Value"),
      "sb" -> "Shared B"(0: "Value"),
      "m" -> "Group Input"("Max Block Width"),
    }
  }

  expr<float> "Jumper" @(2860, -600) {
    expression =
      "fits * (1.0 - odd) * up * wide * inside * (1.0 - quoin)
       * less_than(h, chance)
       * (1.0 - less_than(hp, chance) * greater_than(j, 0.5))"
    inputs {
      "fits" -> "Fits"(0: "Value"),
      "odd" -> "G Odd"(0: "Value"),
      "up" -> "Fits Up"(0: "Value"),
      "wide" -> "J Wide"(0: "Value"),
      "inside" -> "J Inside"(0: "Value"),
      "quoin" -> "Quoin"(0: "Value"),
      "h" -> "J Hash"(0: "Value"),
      "hp" -> "J Prev Hash"(0: "Value"),
      "j" -> "G Slot"(0: "Value"),
      "chance" -> "Group Input"("Jumper Chance"),
    }
  }

  expr<float> "Z1" @(3100, -600) {
    expression = "z + h + jump * (zu + hu - z - h)"
    inputs {
      "z" -> "S CZ0"(0: "Value"),
      "h" -> "S CH"(0: "Value"),
      "zu" -> "S CZ0 Up"(0: "Value"),
      "hu" -> "S CH Up"(0: "Value"),
      "jump" -> "Jumper"(0: "Value"),
    }
  }

