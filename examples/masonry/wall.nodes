      (0: "Corner Index") -> "F C2"(0: "Corner Index"),
    }
  }

  node "F V3" [GeometryNodeVertexOfCorner] @(2740, -2960) {
    inputs {
      (0: "Corner Index") -> "F C3"(0: "Corner Index"),
    }
  }

  node "F Z0" [GeometryNodeSampleIndex] @(2920, -2540) {
    inputs {
      (0: "Geometry") -> "Group Input"("Geometry"),
      (1: "Value") -> "W XYZ"(2: "Z"),
