  expr<float> "Fits" @(2620, -160) {
    expression = "act * less_than(z + h, lh + 1e-4)"
    inputs {
      "act" -> "B Part"(3: "Active"),
      "z" -> "S CZ0"(0: "Value"),
      "h" -> "S CH"(0: "Value"),
      "lh" -> "Seg HH"(0: "Value"),
    }
  }

  expr<float> "Fits Up" @(2620, -300) {
    expression = "act * less_than(z + h, lh + 1e-4)"
    inputs {
      "act" -> "S CAct Up"(0: "Value"),
      "z" -> "S CZ0 Up"(0: "Value"),
      "h" -> "S CH Up"(0: "Value"),
      "lh" -> "Seg HH"(0: "Value"),
