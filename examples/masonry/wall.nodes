  node "F Z3" [GeometryNodeSampleIndex] @(2920, -2960) {
    inputs {
      (0: "Geometry") -> "Group Input"("Geometry"),
      (1: "Value") -> "W XYZ"(2: "Z"),
      (2: "Index") -> "F V3"(0: "Vertex Index"),
