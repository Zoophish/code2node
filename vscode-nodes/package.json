{
  "name": "blender-nodes-dsl",
  "displayName": "Blender Nodes DSL",
  "description": "Syntax highlighting for .nodes and .nodetypes files",
  "version": "0.1.0",
  "publisher": "code2node",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "languages": [
      {
        "id": "blender-nodes",
        "aliases": ["Blender Nodes"],
        "extensions": [".nodes", ".nodetypes"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blender-nodes",
        "scopeName": "source.blender-nodes",
        "path": "./syntaxes/nodes.tmLanguage.json"
      }
    ]
  }
}
