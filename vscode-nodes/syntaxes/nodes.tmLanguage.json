{
  "scopeName": "source.blender-nodes",
  "name": "Blender Nodes DSL",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#tree-block"
    },
    {
      "include": "#type-block"
    },
    {
      "include": "#node-block"
    },
    {
      "include": "#frame-block"
    },
    {
      "include": "#expr-block"
    },
    {
      "include": "#repeat-block"
    },
    {
      "include": "#inputs-block"
    },
    {
      "include": "#section-block"
    },
    {
      "include": "#all-tokens"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.blender-nodes"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.blender-nodes"
        },
        {
          "match": "#\\w+",
          "name": "keyword.control.directive.blender-nodes"
        }
      ]
    },
    "tree-block": {
      "begin": "^\\s*(tree)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.tree.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#tree-type"
            },
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#frame-block"
        },
        {
          "include": "#node-block"
        },
        {
          "include": "#expr-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "type-block": {
      "begin": "^\\s*(type)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.type.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#section-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "node-block": {
      "begin": "^\\s*(node)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.node.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#location-metadata"
            },
            {
              "include": "#bl-idname"
            },
            {
              "include": "#label-literal"
            },
            {
              "include": "#label-attr"
            },
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#inputs-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "repeat-block": {
      "begin": "^\\s*(repeat|closure)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.repeat.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#location-metadata"
            },
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#frame-block"
        },
        {
          "include": "#node-block"
        },
        {
          "include": "#expr-block"
        },
        {
          "include": "#inputs-block"
        },
        {
          "include": "#section-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "inputs-block": {
      "begin": "^\\s*(inputs|outputs)\\s*(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.blender-nodes"
        },
        "2": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "section-block": {
      "begin": "^\\s*(properties|children|sockets|variant|interface|items)\\b(.*?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#inputs-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "all-tokens": {
      "patterns": [
        {
          "include": "#location-metadata"
        },
        {
          "include": "#connection-operator"
        },
        {
          "include": "#assignment-operator"
        },
        {
          "include": "#bl-idname"
        },
        {
          "include": "#socket-type"
        },
        {
          "include": "#tree-type"
        },
        {
          "include": "#boolean"
        },
        {
          "include": "#number"
        },
        {
          "include": "#label-literal"
        },
        {
          "include": "#node-tree-ref"
        },
        {
          "include": "#socket-ref-name"
        },
        {
          "include": "#node-ref-name"
        },
        {
          "include": "#declared-name"
        },
        {
          "include": "#quoted-string"
        },
        {
          "include": "#enum-value"
        },
        {
          "include": "#property-keys"
        },
        {
          "include": "#keywords"
        }
      ]
    },
    "tree-type": {
      "match": "\\b\\w+NodeTree\\b",
      "name": "support.type.tree.blender-nodes"
    },
    "quoted-string": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.blender-nodes"
    },
    "name-string": {
      "match": "\"[^\"]*\"",
      "name": "constant.other.symbol.blender-nodes"
    },
    "label-literal": {
      "match": "\\b(label|description|expression)\\s*(=)\\s*(\"[^\"]*\")",
      "captures": {
        "1": {
          "name": "support.variable.property.blender-nodes"
        },
        "2": {
          "name": "keyword.operator.assignment.blender-nodes"
        },
        "3": {
          "name": "string.quoted.double.blender-nodes"
        }
      }
    },
    "node-tree-ref": {
      "match": "\\b(node_tree)\\s*(=)\\s*(\"[^\"]*\")",
      "captures": {
        "1": {
          "name": "support.variable.property.blender-nodes"
        },
        "2": {
          "name": "keyword.operator.assignment.blender-nodes"
        },
        "3": {
          "name": "constant.other.symbol.blender-nodes"
        }
      }
    },
    "socket-ref-name": {
      "patterns": [
        {
          "match": "(\\()\\s*(\\d+)\\s*(:)\\s*(\"[^\"]*\")",
          "captures": {
            "2": {
              "name": "constant.numeric.blender-nodes"
            },
            "4": {
              "name": "constant.other.symbol.blender-nodes"
            }
          }
        },
        {
          "match": "\\(\\s*(\"[^\"]*\")\\s*(?=\\))",
          "captures": {
            "1": {
              "name": "constant.other.symbol.blender-nodes"
            }
          }
        }
      ]
    },
    "node-ref-name": {
      "match": "\"[^\"]*\"(?=\\s*\\()",
      "name": "constant.other.symbol.blender-nodes"
    },
    "declared-name": {
      "match": "\"[^\"]*\"(?=\\s*(->|[:=]))",
      "name": "constant.other.symbol.blender-nodes"
    },
    "bare-name": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_.]*\\b",
      "name": "variable.other.blender-nodes"
    },
    "keywords": {
      "match": "\\b(tree|node|inputs|outputs|properties|sockets|variant|type|interface|input|output|repeat|closure|items|frame|children|reroute|iterations|import|expr)\\b",
      "name": "keyword.control.blender-nodes"
    },
    "property-keys": {
      "match": "\\b(node_tree|label|mute|hide|description|expression)\\b",
      "name": "support.variable.property.blender-nodes"
    },
    "connection-operator": {
      "match": "->",
      "name": "keyword.operator.connection.blender-nodes"
    },
    "assignment-operator": {
      "match": "=",
      "name": "keyword.operator.assignment.blender-nodes"
    },
    "location-metadata": {
      "match": "@\\([^)]+\\)",
      "name": "comment.block.location.blender-nodes"
    },
    "label-attr": {
      "match": "\\blabel\\s*=",
      "name": "support.variable.property.blender-nodes"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.blender-nodes"
    },
    "number": {
      "match": "-?\\b\\d+(\\.\\d+)?(e[+-]?\\d+)?\\b",
      "name": "constant.numeric.blender-nodes"
    },
    "bl-idname": {
      "match": "\\[[A-Za-z_]\\w*\\]",
      "name": "entity.name.type.node.blender-nodes"
    },
    "socket-type": {
      "match": "\\b(NodeSocket\\w+)\\b",
      "name": "support.type.socket.blender-nodes"
    },
    "enum-value": {
      "match": "\\b[A-Z][A-Z0-9_]{2,}\\b",
      "name": "constant.other.enum.blender-nodes"
    },
    "expr-block": {
      "begin": "^\\s*(expr)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.expr.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#location-metadata"
            },
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#frame-block"
        },
        {
          "include": "#inputs-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    },
    "frame-block": {
      "begin": "^\\s*(frame)\\b(.+?)(\\{)\\s*$",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.frame.blender-nodes"
        },
        "2": {
          "patterns": [
            {
              "include": "#location-metadata"
            },
            {
              "include": "#label-literal"
            },
            {
              "include": "#label-attr"
            },
            {
              "include": "#name-string"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.block.begin.blender-nodes"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.end.blender-nodes"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#inputs-block"
        },
        {
          "include": "#all-tokens"
        }
      ]
    }
  }
}